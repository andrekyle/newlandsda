# Copy this file to `.env.local` for local dev, or set these in your
# Vercel project's Environment Variables panel for production.
# NEVER commit a real `.env` / `.env.local` to git.

# REQUIRED in production. Without it, the admin/edit feature is
# completely disabled (verify + save calls reject with "Unauthorized").
# In local dev when this is unset, any non-empty password unlocks edit
# mode so you can test the flow.
# Pick a long random string. The server compares with a constant-time
# comparison.
ADMIN_PASSWORD=

# Vercel KV / Upstash Redis REST credentials. When you add a Vercel KV
# (Upstash) store in the Vercel dashboard and connect it to this project,
# Vercel populates these automatically — you usually don't set them by
# hand. Locally, leave them blank to use the in-memory dev fallback
# (edits don't persist across server restarts).
KV_REST_API_URL=
KV_REST_API_TOKEN=
